def tts(text, language="all", speaker="all", instruct=""):

    model = Qwen3TTSModel.from_pretrained(
    "Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice",
    device_map="cpu",
    dtype=torch.bfloat16,
    )

    if language == "all":
        language = model.get_supported_languages()
    if speaker == "all":
        speaker = model.get_supported_speakers()

    if isinstance(language, str):
        language=[language]
    if isinstance(speaker, str):
        speaker=[speaker]
    if isinstance(instruct, str):
        instruct=[instruct]

    step = 0
    if isinstance(language, list) and isinstance(speaker, list):
            wavs = []
            for lang in language:
                for spk in speaker:
                    for instr in instruct:
                        step += 1
                        if isinstance(text, str) or len(text)==1:
                            print(f"Generating audio {step} of {len(language)*len(speaker)*len(instruct)}.")
                        else:
                            print(f"Generating audios {step*len(text)-len(text)+1} to {step*len(text)} of {len(text)*len(language)*len(speaker)*len(instruct)}.")
                        wav, sr = model.generate_custom_voice(
                            text=text,
                            language=lang,
                            speaker=spk,
                            instruct=instr
                        )
                        wavs.extend(wav)

    return wavs, sr


def stt(audios, language=None):

    model = whisper.load_model("turbo", device="cpu")
    texts = []
    if isinstance(audios, str):
        audios = [audios]
    for audio in audios:
        if isinstance(audio, np.ndarray):
            audio = audio.astype(np.float32)
        if language is not None:
            result = model.transcribe(audio, language=language)
        else:
            result = model.transcribe(audio)
        texts.append(result["text"])
    return texts

